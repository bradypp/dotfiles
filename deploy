#!/usr/bin/bash
# Restow base plus the detected desktop; make new Stow commands executable.
# Usage: ./deploy [-a|--adopt] [-m|--machine NAME|-n|--no-machine]
set -euo pipefail

script_repo=$(cd -- "${BASH_SOURCE[0]%/*}" && pwd -P)
source "$script_repo/lib/dotfiles.sh"

adopt=()
machine=''
while (($#)); do
    case $1 in
        -a|--adopt)
            adopt=(--adopt)
            shift
            ;;
        -m|--machine)
            (($# >= 2)) || { printf '%s\n' 'deploy: --machine needs a name' >&2; exit 2; }
            machine=$2
            shift 2
            ;;
        -n|--no-machine)
            machine=none
            shift
            ;;
        -h|--help)
            printf '%s\n' 'Usage: ./deploy [-a|--adopt] [-m|--machine NAME|-n|--no-machine]'
            exit 0
            ;;
        -?*)
            options=${1#-}
            shift
            while [[ -n $options ]]; do
                option=${options:0:1}
                options=${options:1}
                case $option in
                    a) adopt=(--adopt) ;;
                    n) machine=none ;;
                    m)
                        [[ -z $options ]] || { printf '%s\n' 'deploy: -m machine name must be a separate argument' >&2; exit 2; }
                        (($#)) || { printf '%s\n' 'deploy: -m needs a name' >&2; exit 2; }
                        machine=$1
                        shift
                        ;;
                    *) printf 'deploy: unknown option: -%s\n' "$option" >&2; exit 2 ;;
                esac
            done
            ;;
        *)
            printf 'deploy: unknown argument: %s\n' "$1" >&2
            exit 2
            ;;
    esac
done

dotfiles_resolve_context "$machine"

# Make newly added Stow commands runnable before linking them.
for package in "${DOTFILES_STOW_PACKAGES[@]}"; do
    while IFS= read -r -d '' candidate; do
        first_line=
        IFS= read -r first_line <"$candidate" || true
        [[ $first_line == '#!'* ]] && chmod u+x "$candidate"
    done < <(find "$DOTFILES_REPO/stow/$package" -type f -print0)
done

selected() {
    local wanted
    for wanted in "${DOTFILES_STOW_PACKAGES[@]}"; do
        [[ $wanted == "$1" ]] && return 0
    done
    return 1
}

# Stow normally prunes removed files during --restow, but a deleted source
# symlink can leave its deployed link broken. Limit cleanup to broken links
# below package-owned top-level paths whose targets resolve inside this repo.
declare -A stow_roots=()
for package_dir in "$DOTFILES_REPO"/stow/*; do
    [[ -d $package_dir ]] || continue
    while IFS= read -r -d '' source_root; do
        stow_roots["$HOME/${source_root##*/}"]=1
    done < <(find "$package_dir" -mindepth 1 -maxdepth 1 -print0)
done

for stow_root in "${!stow_roots[@]}"; do
    [[ -e $stow_root || -L $stow_root ]] || continue
    while IFS= read -r -d '' stale_link; do
        [[ $stale_link == "$DOTFILES_REPO"/* ]] && continue
        resolved_target=$(readlink -m -- "$stale_link")
        case $resolved_target in
            "$DOTFILES_REPO"/stow/*/*)
                rm -- "$stale_link"
                ;;
        esac
    done < <(find "$stow_root" -xtype l -print0)
done

for package_dir in "$DOTFILES_REPO"/stow/*; do
    [[ -d $package_dir ]] || continue
    package=${package_dir##*/}
    selected "$package" && continue
    stow --delete --no-folding --dir="$DOTFILES_REPO/stow" --target="$HOME" "$package"
done

stow --restow "${adopt[@]}" --no-folding --dir="$DOTFILES_REPO/stow" --target="$HOME" \
    "${DOTFILES_STOW_PACKAGES[@]}"

mkdir -p "$DOTFILES_STATE_HOME"
if [[ -n $DOTFILES_MACHINE ]]; then
    printf '%s\n' "$DOTFILES_MACHINE" >"$DOTFILES_STATE_HOME/machine.tmp"
    mv -f "$DOTFILES_STATE_HOME/machine.tmp" "$DOTFILES_STATE_HOME/machine"
else
    rm -f "$DOTFILES_STATE_HOME/machine"
fi

printf 'Deployed: %s' "${DOTFILES_STOW_PACKAGES[*]}"
[[ -n $DOTFILES_MACHINE ]] && printf ' (machine: %s)' "$DOTFILES_MACHINE"
printf '\n'
