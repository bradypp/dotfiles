#!/usr/bin/bash
set -euo pipefail
repo=${DOTFILES_COMMAND_ROOT:-$(cd -- "${BASH_SOURCE[0]%/*}" && pwd -P)}
skip_install=false
machine_args=()
while (($#)); do
    case $1 in
        --skip-install) skip_install=true; shift ;;
        --machine)
            (($# >= 2)) || { printf '%s\n' 'bootstrap: --machine needs a name' >&2; exit 2; }
            machine_args=(--machine "$2"); shift 2 ;;
        --no-machine) machine_args=(--no-machine); shift ;;
        -h|--help)
            printf '%s\n' 'Usage: ./bootstrap [--skip-install] [--machine NAME|--no-machine]'
            exit 0 ;;
        *) printf 'bootstrap: unknown argument: %s\n' "$1" >&2; exit 2 ;;
    esac
done
$skip_install || "$repo/install"
"$repo/deploy" "${machine_args[@]}"
"$repo/configure" "${machine_args[@]}"
"$repo/verify"
