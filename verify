#!/usr/bin/bash
# Read-only verification for state managed by this repository.
set -euo pipefail

script_repo=$(cd -- "${BASH_SOURCE[0]%/*}" && pwd -P)
source "$script_repo/lib/dotfiles.sh"
dotfiles_resolve_context ''

context=base
if dotfiles_is_kde; then context=kde; fi
printf 'context: %s / %s\n' "$context" "${DOTFILES_MACHINE:-none}"

stow --simulate --restow --no-folding --dir="$DOTFILES_REPO/stow" --target="$HOME" \
    "${DOTFILES_STOW_PACKAGES[@]}" >/dev/null

links=0
active_package() {
    local active
    for active in "${DOTFILES_STOW_PACKAGES[@]}"; do
        [[ $active == "$1" ]] && return 0
    done
    return 1
}
for package in "${DOTFILES_STOW_PACKAGES[@]}"; do
    package_root=$DOTFILES_REPO/stow/$package
    [[ -d $package_root ]] || { printf 'Missing Stow package: %s\n' "$package" >&2; exit 1; }
    while IFS= read -r -d '' source; do
        relative=${source#"$package_root"/}
        target=$HOME/$relative
        [[ -L $target ]] || { printf 'Incorrect or missing link: %s\n' "$target" >&2; exit 1; }
        [[ $(readlink -f -- "$target") == $(readlink -f -- "$source") ]] || {
            printf 'Incorrect link target: %s\n' "$target" >&2; exit 1
        }
        ((links += 1))
    done < <(find "$package_root" \( -type f -o -type l \) -print0)
done
for package_root in "$DOTFILES_REPO"/stow/*; do
    [[ -d $package_root ]] || continue
    package=${package_root##*/}
    active_package "$package" && continue
    while IFS= read -r -d '' source; do
        relative=${source#"$package_root"/}
        target=$HOME/$relative
        if [[ -L $target ]] && [[ $(readlink -f -- "$target") == $(readlink -f -- "$source") ]]; then
            printf 'Inactive Stow package remains linked: %s (%s)\n' "$package" "$target" >&2
            exit 1
        fi
    done < <(find "$package_root" \( -type f -o -type l \) -print0)
done
printf 'stow: %d links verified (%s)\n' "$links" "${DOTFILES_STOW_PACKAGES[*]}"

if dotfiles_is_kde; then
    resolved=$(xdg-terminal-exec --print-id)
    [[ -n $resolved ]] || { printf '%s\n' 'xdg-terminal-exec returned no terminal ID' >&2; exit 1; }
    xdg-terminal-exec --print-path >/dev/null
    xdg-terminal-exec --print-cmd >/dev/null
    printf 'terminal: %s\n' "$resolved"

    unit=${XDG_CONFIG_HOME:-$HOME/.config}/systemd/user/klipper-paste-on-select.service
    if [[ -e $unit ]]; then
        systemd-analyze --user verify "$unit" >/dev/null
        systemctl --user is-enabled --quiet klipper-paste-on-select.service
        systemctl --user is-active --quiet klipper-paste-on-select.service
        systemctl --user is-active --quiet ydotool.service
        printf '%s\n' 'services: ydotool and klipper active'
    fi
fi

if [[ -n $DOTFILES_MACHINE_CONFIG ]]; then
    hdr_output= vorta_drive_uuid= vorta_mount_point=
    while IFS= read -r line || [[ -n $line ]]; do
        [[ -z $line || $line == \#* ]] && continue
        key=${line%%=*}; value=${line#*=}
        case $key in
            hdr_output|vorta_drive_uuid|vorta_mount_point) printf -v "$key" '%s' "$value" ;;
            *) printf 'Unknown machine key: %s\n' "$key" >&2; exit 1 ;;
        esac
    done <"$DOTFILES_MACHINE_CONFIG"
    [[ -n $hdr_output && -n $vorta_drive_uuid && $vorta_mount_point == /* ]] || {
        printf 'Incomplete machine configuration: %s\n' "$DOTFILES_MACHINE_CONFIG" >&2; exit 1
    }
    outputs=$(kscreen-doctor -o 2>/dev/null | sed 's/\x1b\[[0-9;]*m//g')
    printf '%s\n' "$outputs" | awk -v out="$hdr_output" '$1 == "Output:" && $3 == out { found=1 } END { exit !found }' || {
        printf 'Configured HDR output not found: %s\n' "$hdr_output" >&2; exit 1
    }
    findmnt --noheadings --raw --source "UUID=$vorta_drive_uuid" --target "$vorta_mount_point" >/dev/null || {
        printf 'Vorta drive %s is not mounted at %s\n' "$vorta_drive_uuid" "$vorta_mount_point" >&2
        exit 1
    }
    command -v vorta >/dev/null || { printf '%s\n' 'Vorta is not installed' >&2; exit 1; }
    command -v borg >/dev/null || { printf '%s\n' 'Borg is not installed' >&2; exit 1; }
    printf '%s\n' 'hardware: HDR output present; Vorta drive mounted'
fi

printf '%s\n' 'result: PASS'
