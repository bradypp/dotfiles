#!/usr/bin/bash
# Read-only verification for state managed by this repository.
set -euo pipefail

script_repo=$(cd -- "${BASH_SOURCE[0]%/*}" && pwd -P)
source "$script_repo/lib/dotfiles.sh"
dotfiles_resolve_context ''

pass_check() {
    printf '%s: PASS (%s)\n' "$1" "$2"
}

fail_check() {
    printf '%s: FAIL (%s)\n' "$1" "$2" >&2
    exit 1
}

require_command() {
    command -v "$2" >/dev/null 2>&1 || fail_check "$1" "missing command: $2"
}

active_package() {
    local active
    for active in "${DOTFILES_STOW_PACKAGES[@]}"; do
        [[ $active == "$1" ]] && return 0
    done
    return 1
}

desktop_entry_exists() {
    local data_home=${XDG_DATA_HOME:-$HOME/.local/share} directory
    if [[ -f $data_home/applications/$1 ]]; then
        return 0
    fi
    IFS=: read -r -a data_dirs <<<"${XDG_DATA_DIRS:-/usr/local/share:/usr/share}"
    for directory in "${data_dirs[@]}"; do
        [[ -f $directory/applications/$1 ]] && return 0
    done
    return 1
}

verify_stow() {
    local links=0 package package_root source relative target stow_output
    require_command stow stow
    if ! stow_output=$(stow --simulate --restow --no-folding --dir="$DOTFILES_REPO/stow" --target="$HOME" \
        "${DOTFILES_STOW_PACKAGES[@]}" 2>&1); then
        while IFS= read -r line; do
            [[ $line == 'WARNING: in simulation mode so not modifying filesystem.' ]] || printf '%s\n' "$line" >&2
        done <<<"$stow_output"
        fail_check stow 'composition has conflicts'
    fi

    for package in "${DOTFILES_STOW_PACKAGES[@]}"; do
        package_root=$DOTFILES_REPO/stow/$package
        [[ -d $package_root ]] || fail_check stow "missing package: $package"
        while IFS= read -r -d '' source; do
            relative=${source#"$package_root"/}
            target=$HOME/$relative
            [[ -L $target ]] || fail_check stow "incorrect or missing link: $target"
            [[ $(readlink -f -- "$target") == $(readlink -f -- "$source") ]] ||
                fail_check stow "incorrect link target: $target"
            ((links += 1))
        done < <(find "$package_root" \( -type f -o -type l \) -print0)
    done

    for package_root in "$DOTFILES_REPO"/stow/*; do
        [[ -d $package_root ]] || continue
        package=${package_root##*/}
        active_package "$package" && continue
        while IFS= read -r -d '' source; do
            relative=${source#"$package_root"/}
            target=$HOME/$relative
            if [[ -L $target ]] && [[ $(readlink -f -- "$target") == $(readlink -f -- "$source") ]]; then
                fail_check stow "Inactive Stow package remains linked: $package ($target)"
            fi
        done < <(find "$package_root" \( -type f -o -type l \) -print0)
    done

    pass_check stow "$links links; ${DOTFILES_STOW_PACKAGES[*]}"
}

verify_terminal() {
    local terminal_service
    require_command terminal kreadconfig6
    terminal_service=$(kreadconfig6 --file kdeglobals --group General --key TerminalService 2>/dev/null)
    [[ -n $terminal_service ]] || terminal_service=org.kde.konsole.desktop
    desktop_entry_exists "$terminal_service" || fail_check terminal "desktop entry not found: $terminal_service"
    pass_check terminal "$terminal_service"
}

verify_ydotool() {
    local drop_in=${XDG_CONFIG_HOME:-$HOME/.config}/systemd/user/ydotool.service.d/retry-uinput.conf
    local runtime_dir=${XDG_RUNTIME_DIR:-/run/user/$UID}
    [[ -e $drop_in ]] || return 0

    require_command ydotool systemctl
    systemctl --user is-enabled --quiet ydotool.service || fail_check ydotool 'service is disabled'
    systemctl --user is-active --quiet ydotool.service || fail_check ydotool 'service is inactive'
    [[ $(systemctl --user show ydotool.service -p StartLimitIntervalUSec --value) == 0 ]] ||
        fail_check ydotool 'retry policy is not active'
    [[ -S $runtime_dir/.ydotool_socket ]] || fail_check ydotool 'socket is missing'
    pass_check ydotool 'service active; resilient retry policy; socket available'
}

verify_klipper() {
    local unit=${XDG_CONFIG_HOME:-$HOME/.config}/systemd/user/klipper-paste-on-select.service
    [[ -e $unit ]] || return 0

    require_command klipper systemd-analyze
    require_command klipper systemctl
    systemd-analyze --user verify "$unit" >/dev/null || fail_check klipper 'invalid user service'
    systemctl --user is-enabled --quiet klipper-paste-on-select.service || fail_check klipper 'service is disabled'
    systemctl --user is-active --quiet klipper-paste-on-select.service || fail_check klipper 'service is inactive'
    pass_check klipper 'paste-on-select service active'
}

verify_copyq() {
    require_command copyq copyq
    copyq version >/dev/null || fail_check copyq 'server is unavailable'
    [[ $(copyq config activate_pastes) == true ]] || fail_check copyq 'paste-on-activation is disabled'
    [[ $(copyq eval 'commands().some(function(c) { return c.name == "Wayland Support" && c.enable; })') == true ]] ||
        fail_check copyq 'Wayland Support command is missing or disabled'
    pass_check copyq 'Wayland paste support'
}

verify_hardware() {
    local hdr_output= vorta_drive_uuid= vorta_mount_point= line key value outputs
    while IFS= read -r line || [[ -n $line ]]; do
        [[ -z $line || $line == \#* ]] && continue
        key=${line%%=*}; value=${line#*=}
        case $key in
            hdr_output|vorta_drive_uuid|vorta_mount_point) printf -v "$key" '%s' "$value" ;;
            *) fail_check hardware "unknown machine key: $key" ;;
        esac
    done <"$DOTFILES_MACHINE_CONFIG"

    [[ -n $hdr_output && -n $vorta_drive_uuid && $vorta_mount_point == /* ]] ||
        fail_check hardware "incomplete machine configuration: $DOTFILES_MACHINE_CONFIG"
    require_command hardware kscreen-doctor
    require_command hardware findmnt
    require_command hardware vorta
    require_command hardware borg

    outputs=$(kscreen-doctor -o 2>/dev/null | sed 's/\x1b\[[0-9;]*m//g')
    printf '%s\n' "$outputs" | awk -v out="$hdr_output" \
        '$1 == "Output:" && $3 == out { found=1 } END { exit !found }' ||
        fail_check hardware "configured HDR output not found: $hdr_output"
    findmnt --noheadings --raw --source "UUID=$vorta_drive_uuid" --mountpoint "$vorta_mount_point" >/dev/null ||
        fail_check hardware "Vorta drive $vorta_drive_uuid is not mounted at $vorta_mount_point"
    pass_check hardware 'HDR output; Vorta drive'
}

context=base
if dotfiles_is_kde; then context=kde; fi
pass_check context "$context / ${DOTFILES_MACHINE:-none}"
verify_stow
if dotfiles_is_kde; then
    verify_terminal
    verify_klipper
fi
if [[ ${DOTFILES_SESSION_TYPE,,} == wayland ]]; then
    verify_ydotool
    verify_copyq
fi
if [[ -n $DOTFILES_MACHINE_CONFIG ]]; then
    verify_hardware
fi
printf '%s\n' 'result: PASS'
