#!/usr/bin/bash
# Verify the terminal selected through kde-xdg-terminals.list.
set -euo pipefail

list=${XDG_CONFIG_HOME:-$HOME/.config}/kde-xdg-terminals.list
[[ -r $list ]] || { printf 'Missing terminal selection: %s\n' "$list" >&2; exit 1; }
id=$(while IFS= read -r line; do
    [[ -n $line && $line != \#* ]] && { printf '%s\n' "$line"; break; }
done <"$list")
[[ -n $id && $id != */* ]] || { printf 'Invalid terminal desktop ID\n' >&2; exit 1; }

found=false
IFS=: read -r -a data_dirs <<<"${XDG_DATA_DIRS:-/usr/local/share:/usr/share}"
for dir in "${XDG_DATA_HOME:-$HOME/.local/share}" "${data_dirs[@]}"; do
    [[ -f $dir/applications/$id ]] && { found=true; break; }
done
$found || { printf 'Terminal desktop file not found: %s\n' "$id" >&2; exit 1; }

resolved=$(xdg-terminal-exec --print-id)
[[ $resolved == "$id" ]] || {
    printf 'Terminal mismatch: configured %s, resolved %s\n' "$id" "$resolved" >&2
    exit 1
}
printf 'Terminal: %s\n' "$resolved"
xdg-terminal-exec --print-path
xdg-terminal-exec --print-cmd
