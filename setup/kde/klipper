#!/usr/bin/bash
# Configure Klipper paste-after-selection on KDE Wayland.
#
# Checks for Plasma Workspace, ydotool, kdotool, and D-Bus; then enables and
# starts the stowed klipper-paste-on-select user service.
# The service helper lives at ~/.local/libexec/klipper-paste-on-select. Selecting
# older history entries pastes automatically; selecting the already-current
# first entry remains a known limitation.
set -euo pipefail

readonly REQUIRED_COMMANDS=(plasmashell ydotool kdotool dbus-monitor systemctl)
readonly SERVICE=klipper-paste-on-select.service

check_commands() {
    local command_name
    local missing=()

    for command_name in "${REQUIRED_COMMANDS[@]}"; do
        command -v "$command_name" >/dev/null 2>&1 || missing+=("$command_name")
    done

    if ((${#missing[@]})); then
        printf 'Missing commands: %s\n' "${missing[*]}" >&2
        return 1
    fi
}

main() {
    check_commands

    if [[ ${XDG_SESSION_TYPE:-} != wayland || ${XDG_CURRENT_DESKTOP:-} != KDE ]]; then
        printf 'Warning: designed for KDE Wayland; detected session=%s desktop=%s\n' \
            "${XDG_SESSION_TYPE:-unknown}" "${XDG_CURRENT_DESKTOP:-unknown}" >&2
    fi

    /usr/bin/systemctl --user daemon-reload
    /usr/bin/systemctl --user enable --now "$SERVICE"
    /usr/bin/systemctl --user restart "$SERVICE"

    /usr/bin/systemctl --user is-active --quiet "$SERVICE"
    printf 'Klipper paste-on-selection: enabled and active\n'
    printf 'Known limitation: selecting the already-current first entry may not paste.\n'
}

main "$@"
