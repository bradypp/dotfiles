#!/usr/bin/bash
# Confirm the HDR output and data drives declared by this machine.
set -euo pipefail

(($# == 1)) || { printf '%s\n' 'Usage: setup/hardware MACHINE_CONFIG' >&2; exit 2; }
config=$1
[[ -f $config ]] || { printf 'Missing machine configuration: %s\n' "$config" >&2; exit 1; }

hdr_output=
disk1_uuid=; disk1_mount=
disk2_uuid=; disk2_mount=
disk3_uuid=; disk3_mount=
declare -A seen=()
read_config() {
    local line key value
    hdr_output=
    disk1_uuid=; disk1_mount=
    disk2_uuid=; disk2_mount=
    disk3_uuid=; disk3_mount=
    seen=()
    while IFS= read -r line || [[ -n $line ]]; do
        [[ -z $line || $line == \#* ]] && continue
        [[ $line == *=* ]] || { printf 'Invalid machine line: %s\n' "$line" >&2; return 1; }
        key=${line%%=*}
        value=${line#*=}
        case $key in
            hdr_output|disk1_uuid|disk1_mount|disk2_uuid|disk2_mount|disk3_uuid|disk3_mount) ;;
            *) printf 'Unknown machine key: %s\n' "$key" >&2; return 1 ;;
        esac
        [[ ! ${seen[$key]+set} ]] || { printf 'Duplicate machine key: %s\n' "$key" >&2; return 1; }
        seen[$key]=1
        printf -v "$key" '%s' "$value"
    done <"$config"
}

valid_drive() {
    [[ -n $1 && $1 != /dev/* && $1 != *[[:space:]]* ]] || return 1
    [[ $2 == /* ]] || return 1
}

validate() {
    [[ -n $hdr_output && $hdr_output != *[[:space:]]* ]] || { printf '%s\n' 'Invalid or missing hdr_output' >&2; return 1; }
    local drive uuid_var mount_var
    for drive in disk1 disk2 disk3; do
        uuid_var=${drive}_uuid; mount_var=${drive}_mount
        if [[ -n ${!uuid_var} || -n ${!mount_var} ]]; then
            valid_drive "${!uuid_var}" "${!mount_var}" || {
                printf 'Invalid %s drive; %s_uuid needs a filesystem UUID and %s_mount an absolute path\n' \
                    "$drive" "$drive" "$drive" >&2; return 1
            }
        fi
    done
}

read_config
interactive=${DOTFILES_INTERACTIVE:-}
[[ -n $interactive ]] || { [[ -t 0 ]] && interactive=1 || interactive=0; }
if [[ $interactive == 1 ]]; then
    command -v kscreen-doctor >/dev/null && kscreen-doctor -o || true
    lsblk --output NAME,LABEL,UUID,FSTYPE,SIZE,MOUNTPOINTS
    printf 'Change the saved monitor or drives? [y/N] '
    read -r answer
    if [[ $answer == [yY] || $answer == [yY][eE][sS] ]]; then
        read -r -p "HDR output [$hdr_output]: " new_hdr
        read -r -p "disk1 UUID [$disk1_uuid]: " new_disk1_uuid
        read -r -p "disk1 mount [$disk1_mount]: " new_disk1_mount
        read -r -p "disk2 UUID [$disk2_uuid]: " new_disk2_uuid
        read -r -p "disk2 mount [$disk2_mount]: " new_disk2_mount
        read -r -p "disk3 UUID [$disk3_uuid]: " new_disk3_uuid
        read -r -p "disk3 mount [$disk3_mount]: " new_disk3_mount
        hdr_output=${new_hdr:-$hdr_output}
        disk1_uuid=${new_disk1_uuid:-$disk1_uuid}
        disk1_mount=${new_disk1_mount:-$disk1_mount}
        disk2_uuid=${new_disk2_uuid:-$disk2_uuid}
        disk2_mount=${new_disk2_mount:-$disk2_mount}
        disk3_uuid=${new_disk3_uuid:-$disk3_uuid}
        disk3_mount=${new_disk3_mount:-$disk3_mount}
        validate
        printf 'Save these values? [y/N] '
        read -r answer
        [[ $answer == [yY] || $answer == [yY][eE][sS] ]] || { printf '%s\n' 'Hardware setup skipped.'; exit 0; }
        tmp=$(mktemp "${config}.tmp.XXXXXX")
        trap 'rm -f -- "${tmp:-}"' EXIT
        printf 'hdr_output=%s\ndisk1_uuid=%s\ndisk1_mount=%s\ndisk2_uuid=%s\ndisk2_mount=%s\ndisk3_uuid=%s\ndisk3_mount=%s\n' \
            "$hdr_output" \
            "$disk1_uuid" "$disk1_mount" "$disk2_uuid" "$disk2_mount" \
            "$disk3_uuid" "$disk3_mount" >"$tmp"
        mv -- "$tmp" "$config"
        trap - EXIT
    fi
fi
validate

kscreen=$(kscreen-doctor -o 2>/dev/null | sed 's/\x1b\[[0-9;]*m//g' || true)
printf '%s\n' "$kscreen" | awk -v out="$hdr_output" '$1 == "Output:" && $3 == out { found=1 } END { exit !found }' || {
    printf 'Configured HDR output not found: %s\n' "$hdr_output" >&2
    exit 1
}
blocks=$(lsblk --output NAME,LABEL,UUID,FSTYPE,SIZE,MOUNTPOINTS)
check_drive() {
    [[ $blocks == *"$1"* ]] || { printf 'Configured drive not found: %s\n' "$1" >&2; exit 1; }
    findmnt --noheadings --raw --source "UUID=$1" --mountpoint "$2" >/dev/null || {
        printf 'Drive %s is not mounted at %s\n' "$1" "$2" >&2
        exit 1
    }
}
printf 'HDR output: %s\n' "$hdr_output"
drive=; uuid_var=; mount_var=
for drive in disk1 disk2 disk3; do
    uuid_var=${drive}_uuid; mount_var=${drive}_mount
    if [[ -n ${!uuid_var} ]]; then
        check_drive "${!uuid_var}" "${!mount_var}"
        printf 'Drive %s: %s at %s\n' "$drive" "${!uuid_var}" "${!mount_var}"
    fi
done
