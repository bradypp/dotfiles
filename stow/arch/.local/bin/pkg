#!/bin/sh
# Fuzzy-find packages and install them: repo packages by default, AUR with -a.
# Usage: pkg [--aur|-a] [query...]   (Tab marks, Enter installs)
set -eu

usage() {
  printf '%s\n' 'Usage: pkg [--aur|-a|--flatpak|-f] [query...]' >&2
}

backend=repo
case ${1-} in
  -a|--aur) backend=aur; shift ;;
  -f|--flatpak) backend=flatpak; shift ;;
  -h|--help) usage; exit 0 ;;
esac

if [ ! -t 0 ] || [ ! -t 1 ]; then
  printf '%s\n' 'pkg needs an interactive terminal.' >&2
  exit 2
fi

if [ "$backend" = aur ]; then
  command -v jq >/dev/null 2>&1 || {
    printf '%s\n' 'pkg --aur needs jq.' >&2
    exit 1
  }
  [ $# -gt 0 ] || { printf '%s\n' 'pkg --aur needs a search query.' >&2; usage; exit 2; }
  names=$(shelly search aur -j "$@" | jq -r '.[] | "\(.Name)\t\(.Version)\t\(.Description // "")"' \
    | fzf -m --delimiter='\t' --with-nth=1,2,3 --prompt='aur> ' \
    --preview 'shelly search aur -d {1} 2>/dev/null; echo; echo AUR: https://aur.archlinux.org/packages/{1}; echo; shelly search aur -p {1} 2>/dev/null | head -n 40' \
    --bind 'ctrl-o:execute-silent(xdg-open https://aur.archlinux.org/packages/{1})' \
    | cut -f1) || exit $?
  [ -n "$names" ] || exit 0
  # shellcheck disable=SC2086
  printf 'Installing from AUR: %s\n' "$names"
  # shellcheck disable=SC2086
  exec shelly install aur $names
elif [ "$backend" = flatpak ]; then
  command -v jq >/dev/null 2>&1 || {
    printf '%s\n' 'pkg --flatpak needs jq.' >&2
    exit 1
  }
  [ $# -gt 0 ] || { printf '%s\n' 'pkg --flatpak needs a search query.' >&2; usage; exit 2; }
  tmp=$(mktemp) || exit 1
  trap 'rm -f "$tmp"' EXIT INT TERM
  shelly search flatpak -j "$@" >"$tmp" || exit $?
  # NOTE: {1} must stay unquoted below: fzf shell-quotes substitutions
  # itself, so "--arg id \"{1}\"" would match a literally-quoted ID.
  export PKG_FLATPAK_JSON="$tmp"
  ids=$(jq -r '.hits[] | "\(.app_id)\t\(.name)\t\(.remote)\t\(.summary // "")"' "$tmp" \
    | fzf -m --delimiter='\t' --with-nth=1,2,3,4 --prompt='flatpak> ' \
    --preview 'jq -r --arg id {1} '\''.hits[] | select(.app_id==$id) | "\(.name) (\(.app_id))\nRemote: \(.remote)\nDeveloper: \(.developer_name // "?")\nDownload: \(.download_size)  Installed: \(.installed_size)\n\n\(.summary // "")\n\n\(.description // "")\n\nPermissions:\n\(((.permissions // []) | join("\n")))"'\'' "$PKG_FLATPAK_JSON"' \
    | cut -f1) || exit $?
  rm -f "$tmp"
  trap - EXIT INT TERM
  unset PKG_FLATPAK_JSON
  [ -n "$ids" ] || exit 0
  # shellcheck disable=SC2086
  printf 'Installing flatpak: %s\n' "$ids"
  # shellcheck disable=SC2086
  exec shelly install flatpak $ids
else
  if [ $# -gt 0 ]; then
    list=$(pacman -Ssq "$@" | awk '!seen[$0]++') || exit $?
  else
    list=$(pacman -Slq | awk '!seen[$0]++') || exit $?
  fi
  # shellcheck disable=SC2086
  picks=$(printf '%s\n' "$list" | fzf -m --prompt='pkg> ' \
    --preview 'pacman -Si {} 2>/dev/null | head -n 12') || exit $?
  [ -n "$picks" ] || exit 0
  # shellcheck disable=SC2086
  printf 'Installing: %s\n' "$picks"
  # shellcheck disable=SC2086
  exec sudo pacman -S -- $picks
fi
