#!/bin/sh
# Open herdr in the current terminal or through the default terminal launcher.

if [ -t 0 ] && [ -t 1 ]; then
  # Already running inside a terminal: reuse it.
  exec herdr "$@"
else
  # Launched externally, for example by a KDE keyboard shortcut.
  # Use zsh so the user's .zshrc and mise environment load, then leave an
  # interactive login shell behind when the Herdr client detaches.
  exec "$HOME/.local/bin/open-terminal" /usr/bin/zsh -lic \
    'herdr "$@"; exec /usr/bin/zsh -l' zsh "$@"
fi
